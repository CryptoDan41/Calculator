QWidget {
    background-color: #1e1e1e;
}

QLineEdit {
    background-color: #2d2d2d;
    color: #ffffff;
    border: 2px solid #3d3d3d;
    border-radius: 10px;
    padding: 10px;
    font-size: 44px;
}

QPushButton {
    background-color: #3a3a3a;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    font-size: 44px;
}

QPushButton:hover {
    background-color: #4a4a4a;
}

QPushButton:pressed {
    background-color: #5a5a5a;
}
